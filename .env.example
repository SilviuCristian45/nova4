# Copy to .env. Never commit .env. Generate secrets with:  node scripts/gen-secrets.mjs
# Public domain Caddy serves (DNS A record -> the VPS), e.g. replog.example.com
DOMAIN=

# Scheme used by Caddy and public presigned photo URLs (use http only for local testing).
PUBLIC_SCHEME=https

# Core secrets (generated by scripts/gen-secrets.mjs).
# Do not change POSTGRES_PASSWORD or MINIO_ROOT_* after the first start (persisted in volumes).
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Session cookies (set to false only when testing over plain HTTP without TLS).
COOKIE_SECURE=true
COOKIE_DOMAIN=

# Optional: close new user registration once your account exists.
DISABLE_SIGNUP=false

# Optional: set to false to disable self-serve coach role activation (/register & /settings).
COACH_SELF_SERVE=true

# Optional: comma-separated list of Super Admin emails allowed to access /admin & /api/v1/admin/*.
# Leave empty to disable the admin panel completely.
SUPER_ADMIN_EMAILS=

# Optional: expose OpenAPI / Swagger UI at https://<DOMAIN>/api/docs (disabled by default in production).
SWAGGER_ENABLED=false

# Optional: food search fallback (USDA FoodData Central).
USDA_API_KEY=

# Optional: automatic Google Drive backup (the card in Settings stays hidden without all of these).
# The hourly scheduler runs inside the NestJS api container natively (DRIVE_CRON_ENABLED=true).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<your-domain>/api/v1/drive/callback
DRIVE_TOKEN_KEY=
CRON_SECRET=
DRIVE_CRON_ENABLED=true
