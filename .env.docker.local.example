# Example environment file for running the full RepLog Docker stack locally (`npm run docker:local`).
#
# Tip: You do NOT have to create `.env.docker.local` manually!
# Running `npm run docker:local` auto-generates `.env.docker.local` with strong random secrets on first run.
# If you prefer to configure it manually (or add optional USDA / Google Drive keys), copy this file:
#   cp .env.docker.local.example .env.docker.local
# and generate random secrets with:
#   node scripts/gen-secrets.mjs

# Local host & HTTP mode (avoids self-signed TLS errors in the browser).
DOMAIN=localhost
PUBLIC_SCHEME=http

# Host ports exposed by Caddy and Adminer (change if 80 / 443 / 8081 are already in use on your PC).
HTTP_PORT=80
HTTPS_PORT=443
ADMINER_PORT=8081

# Session cookies (keep false over plain HTTP on localhost; set true only with HTTPS).
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Local toggles
SWAGGER_ENABLED=true
DISABLE_SIGNUP=false
COACH_SELF_SERVE=true

# Required secrets (generate with `node scripts/gen-secrets.mjs` — do NOT change after first start,
# because POSTGRES_PASSWORD and MINIO_ROOT_* are persisted inside the Docker volumes).
POSTGRES_PASSWORD=change-me-use-gen-secrets
JWT_ACCESS_SECRET=change-me-use-gen-secrets-at-least-32-chars
MINIO_ROOT_USER=reploglocal
MINIO_ROOT_PASSWORD=change-me-use-gen-secrets

# Optional: USDA FoodData Central API key (food search fallback).
USDA_API_KEY=

# Optional: automatic Google Drive backup (leave blank if you don't need Drive backup locally).
# If filled, add `http://localhost/api/v1/drive/callback` in Google Cloud Console -> Authorized redirect URIs.
# Keep the SAME DRIVE_TOKEN_KEY if you migrate existing `google_drive_backups` rows from another instance.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/v1/drive/callback
DRIVE_TOKEN_KEY=
CRON_SECRET=
DRIVE_CRON_ENABLED=true
