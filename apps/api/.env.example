# RepLog NestJS API environment variables
NODE_ENV=development
PORT=4000

# PostgreSQL connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/replog

# Auth & JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Cookie security (set COOKIE_SECURE=true behind HTTPS in production)
COOKIE_SECURE=false
COOKIE_DOMAIN=

# CORS (comma-separated origins for local dev; in production Caddy serves same-origin)
CORS_ORIGINS=http://localhost:3000

# Coach self-serve registration/activation (defaults to true)
COACH_SELF_SERVE=true

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# S3 / MinIO / Cloudflare R2 Object Storage
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PROGRESS_PHOTOS=progress-photos
S3_BUCKET_CHECKIN_PHOTOS=checkin-photos

# Optional food search fallback
USDA_API_KEY=

# Optional Google Drive automatic backup
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
DRIVE_TOKEN_KEY=
CRON_SECRET=
DRIVE_CRON_ENABLED=true
