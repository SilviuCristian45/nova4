# Single public domain for RepLog:
#   /api/v1/*           -> NestJS REST API
#   /api/docs*          -> NestJS OpenAPI / Swagger UI (when SWAGGER_ENABLED=true)
#   /progress-photos/*  -> MinIO presigned object URLs (path preserved for AWS SigV4)
#   /checkin-photos/*   -> MinIO presigned object URLs (path preserved for AWS SigV4)
#   /*                  -> Next.js standalone web app
{$SITE_ADDRESS} {
	encode zstd gzip

	handle /api/v1/* {
		reverse_proxy api:4000
	}
	handle /api/docs* {
		reverse_proxy api:4000
	}
	handle /progress-photos/* {
		reverse_proxy minio:9000
	}
	handle /checkin-photos/* {
		reverse_proxy minio:9000
	}
	handle {
		reverse_proxy web:3000
	}
}
